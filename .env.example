# --- Core ---
DATABASE_URL=postgresql://payload:payload@localhost:5432/payload_middleware
PAYLOAD_SECRET=change-me
SERVER_URL=http://localhost:3000

# --- Inbound webhook (WordPress) ---
# WordPress signs the raw body: hash_hmac('sha256', $body, WEBHOOK_SECRET) -> X-Signature
WEBHOOK_SECRET=change-me-long-random
# Only allow reference-image downloads from this WP host (SSRF guard).
WP_ALLOWED_IMAGE_HOST=www.your-wordpress-site.com

# --- DK / dkPlus API ---
DK_API_BASE=https://api.dkplus.is/api/v1
DK_API_KEY=your-dkplus-guid-token

# --- Email (SMTP). If unset, dev uses nodemailer jsonTransport (no send). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@your-domain.com
DESIGNER_EMAIL=designer@your-domain.com
SALES_EMAIL=sales@your-domain.com

# --- Jobs ---
# Set to true on serverless (Vercel); then trigger /api/payload-jobs/run via external cron.
DISABLE_AUTORUN=

# Optional: override the master template path.
QUOTE_TEMPLATE_PATH=
